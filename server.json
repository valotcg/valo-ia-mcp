{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "com.valotcg/valo-ia",
  "title": "Valo.IA (ValoTCG)",
  "description": "Trading card prices and sheets for Pokémon and 13 other TCGs: Cardmarket, US market, eBay, PSA",
  "version": "1.0.1",
  "websiteUrl": "https://valotcg.com/developers/ia",
  "repository": {
    "url": "https://github.com/valotcg/valo-ia-mcp",
    "source": "github"
  },
  "icons": [
    {
      "src": "https://valotcg.com/web-app-manifest-512x512.png",
      "mimeType": "image/png",
      "sizes": ["512x512"]
    }
  ],
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://api.valotcg.com/mcp",
      "headers": [
        {
          "name": "Authorization",
          "description": "Valo.Data API key (vd_live_…), created at https://valotcg.com/developers/account",
          "value": "Bearer {api_key}",
          "isRequired": true,
          "isSecret": true,
          "variables": {
            "api_key": {
              "description": "Your Valo.Data API key",
              "isRequired": true,
              "isSecret": true
            }
          }
        }
      ]
    }
  ]
}
